  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5879095d5e7f0f41acffdf9d82fa139, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextoFinalProgresivo
  textoFinal: {fileID: 1323705223}
  textoCompleto: "El guardia de seguridad logr\xF3 romper el bucle.\n\nDespu\xE9s
    de tantas sombras y recuerdos imposibles, por fin encontr\xF3 la salida y pudo
    volver a casa.\n\nTal vez aquellos monstruos que marcaron una \xE9poca no solo
    nos ense\xF1aron a tener miedo... sino que, sin saberlo, tambi\xE9n nos prepararon
    para ser valientes, seguir avanzando y encontrar la salida."
  velocidadEscritura: 0.035
